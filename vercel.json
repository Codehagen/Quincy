{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "17 22 * * 1"
    },
    {
      "path": "/api/cron/channels",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/rhythms",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/calendar",
      "schedule": "5 * * * *"
    }
  ]
}
