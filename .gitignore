# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no values — it is the only way a new clone learns which
# variables exist. The blanket .env* above would otherwise swallow it.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.vercel

# Agent worktrees — local scratch, never shared
.claude/worktrees/
/.swc

# Local agent tooling — vendored skills stay out of the repo
.agents/
skills-lock.json

# Build-in-public video scripts and local agent state
videos/
.claude/
