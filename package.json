{
  "name": "quincy",
  "version": "0.0.1",
  "description": "An AI Head of Content: you give it raw material, it drafts in your voice, schedules, and publishes.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Christer Hagen",
  "homepage": "https://hirequincy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codehagen/Quincy.git"
  },
  "bugs": {
    "url": "https://github.com/Codehagen/Quincy/issues"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "JITI_FS_CACHE=false npx -y auth@1.7.2 generate --config lib/auth.ts --output lib/schema.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "email": "email dev --dir emails --port 3001"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.34",
    "@ai-sdk/react": "^4.0.48",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/stripe": "1.7.2",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@remotion/media": "^4.0.506",
    "@remotion/player": "^4.0.506",
    "@remotion/web-renderer": "^4.0.506",
    "@shadcn/helpers": "^0.1.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.45",
    "better-auth": "^1.7.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hash-wasm": "^4.12.0",
    "mcp-handler": "^2.1.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.506",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
