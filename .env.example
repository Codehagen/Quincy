# Copy to .env.local and fill in. .env* is gitignored.

# Neon. Pooled connection string from the Neon console.
DATABASE_URL=""

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend. Senders return a status rather than throwing, so an empty key means
# mail is skipped and logged, not a crash.
RESEND_API_KEY=""

# Send from a verified subdomain so transactional bounces cannot damage the
# apex domain's reputation. Point replies at a mailbox a human reads.
MAIL_FROM="Quincy <hello@mail.hirequincy.com>"
MAIL_REPLY_TO=""

# Signing secret for the Resend webhook, from the webhook's page in the
# dashboard. Delivery events are how bounces and complaints become visible;
# without the secret /api/webhooks/resend rejects everything, because an
# unverified body is an unauthenticated stranger claiming an address bounced.
RESEND_WEBHOOK_SECRET=""

# The GitHub App, for Shipped Work. See plans/021.
#
# All four or none — lib/github-app.ts treats a partial set as unconfigured and
# the webhook answers 503, because verifying a delivery with a missing secret is
# not something to fall back to.
#
# You do not fill these in by hand. Deploy without them, sign in, and open
# /api/connect/github/app — GitHub's manifest flow creates the app in one click
# and hands back exactly these four values to paste here. That route 404s once
# GITHUB_APP_ID is set, so it cannot be run twice by accident.
#
# The private key is a PKCS#1 PEM. Quoted with literal \n, which is what
# `vercel env pull` writes and what lib/github-app.ts unescapes.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_PRIVATE_KEY=""

# Vercel AI Gateway. One key resolves provider/model slugs, so switching models
# is an env change rather than a new SDK.
AI_GATEWAY_API_KEY=""
# The model that writes the posts. Falls through to CHAT_MODEL when unset.
# Separate on purpose: drafting is ~70% of spend and it is also the one output
# published under your name, so making it cheap is its own decision.
DRAFTING_MODEL=

CHAT_MODEL="anthropic/claude-sonnet-5"

# Ceilings on /api/chat — lib/chat-guards.ts. Both are tripwires, not product
# limits: defaults are far past ordinary use and only matter for a runaway
# client or a scripted account.
#
# Per-request message cap. Default 200.
CHAT_MAX_MESSAGES=""
# Per-request character cap, summed across all text parts. Default 400000.
CHAT_MAX_INPUT_CHARS=""
# Per-user rolling-24h spend ceiling, in micro-dollars. Default 10000000
# ($10). Tighten from usage_event data once real spend is on record.
CHAT_DAILY_CEILING_MICROS=""

# Set to "scripted" to drive the chat from lib/scripted-chat.ts with no key and
# no network. Development only — never a production fallback.
NEXT_PUBLIC_CHAT_TRANSPORT=""


# Stripe. Test keys until launch. The price is resolved by lookup key
# ("quincy_monthly"), which is stable across test and live — so going live is
# creating the same key on the live product, not editing this file.
#
# The webhook secret comes from `stripe listen --forward-to \
#   localhost:3000/api/auth/stripe/webhook` in development, and from the
# endpoint's own page in the dashboard in production. They are different
# values; using the dashboard's locally is the usual reason every webhook
# 400s with no obvious cause.
#
# No publishable key: Checkout is a server-side redirect to Stripe's hosted
# page, so Stripe.js never loads in the browser.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google OAuth from console.cloud.google.com. Both must be set or the Google
# button is hidden rather than shown broken.
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Channel connections — where Quincy publishes. See plans/005. Each pair is
# optional and independent: an unconfigured channel hides its Connect button
# rather than offering one that fails on click, the same way Google does above.

# X OAuth 2.0 from console.x.com. The app type must be "Web App, Automated App
# or Bot" — that is what makes it a confidential client, and the token exchange
# sends the secret as HTTP Basic on the strength of it. Not the API key/secret
# on the same page; those are OAuth 1.0a and unused here.
# Scopes: tweet.read tweet.write users.read offline.access
# Callback: {BETTER_AUTH_URL}/api/connect/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# LinkedIn OAuth 2.0 from linkedin.com/developers. The app needs both the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products; both are self-serve and instant once the app is verified by a
# company page admin.
# Scopes: openid profile email w_member_social — frozen. Adding one invalidates
# every existing grant and sends every connected user back through consent.
# There are no refresh tokens on the self-serve tier, so a connection genuinely
# expires after 60 days and the daily cron is what asks the person back.
# Callback: {BETTER_AUTH_URL}/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# LinkedIn versioned APIs require this header, format YYYYMM. Bump it
# deliberately: LinkedIn sunsets each monthly version about a year out and a
# stale value 400s. Floor is 202506 for member post analytics; 202605 changed
# metricType from a union to a plain string.
LINKEDIN_API_VERSION="202607"

# Scheduled jobs. Vercel Cron sends this as `Authorization: Bearer <value>`;
# nothing else does. Generate with: openssl rand -base64 32
#
# All three cron routes refuse to run without it — 503, deliberately, because
# the alternative is a public endpoint that rewrites everyone's memory on
# request, or one that makes other people's writing go out early.
#
# That refusal is silent, and each job loses something different:
#
#   /api/cron/channels  is the only thing that notices when someone removes
#     Quincy at LinkedIn's Permitted Services. Losing it means Quincy keeps
#     trying to publish as a person who withdrew consent — the exact failure
#     the job exists to prevent.
#   /api/cron/publish   is the only thing that sends. Losing it means nothing
#     scheduled ever goes out, and because a post more than two hours late is
#     refused rather than sent, every post queued while it was down is lost
#     rather than delayed. This is the one that fails loudest to users and
#     most quietly to operators.
#   /api/cron/heartbeat is the brain's weekly loop.
#
# Set it in every environment that runs the crons.
CRON_SECRET=""

# The local test account, and the input to a safety guard.
#
# scripts/dev-account.ts creates or repairs it; four verification scripts
# (verify-channels, verify-channel-maintenance, verify-publish,
# verify-publish-run) read the email and refuse to run unless it ends in
# @quincy.test. Those scripts delete channel connections, and
# verify-publish-run additionally deletes drafts, slots and scheduled posts and
# hands queued writing to a stubbed publisher — so that suffix check is the
# thing standing between a verification run and both a real OAuth grant it
# would take a human re-consent to get back, and a real person's queued posts
# being marked published without ever going out. Leave these unset to accept
# the @quincy.test defaults; override only with another @quincy.test address.
DEV_ACCOUNT_EMAIL=""
DEV_ACCOUNT_PASSWORD=""

# Cloudflare R2. Object storage for video: originals, editing proxies, seek
# indexes, thumbnails.
#
# R2 rather than Vercel Blob because egress is free, and editing re-reads the
# same proxy every session. Metered egress on video turns "scrub around a bit"
# into a line item.
#
# Reached over the S3 API — R2 is S3-compatible on purpose, so the client is
# @aws-sdk/client-s3 pointed at Cloudflare. No AWS account is involved.
#
# Where each value comes from, in the Cloudflare dashboard under R2:
#   R2_ACCOUNT_ID       R2 → Overview, right-hand sidebar (also in the URL)
#   R2_BUCKET           the bucket you created, e.g. quincy-media
#   R2_ACCESS_KEY_ID    R2 → API → Manage API tokens → Create (Object Read &
#   R2_SECRET_ACCESS_KEY  Write, scoped to that one bucket). The secret is shown
#                         once and never again.
R2_ACCOUNT_ID=""
R2_BUCKET=""

# "eu" if the bucket was created under the European Union jurisdiction, which
# is a different hostname, not a region. Signing against the default endpoint
# for an EU bucket fails with an error that never mentions jurisdiction.
# Leave empty for a default-jurisdiction bucket.
R2_JURISDICTION=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Optional. A custom domain or the bucket's r2.dev subdomain, set only if the
# bucket serves objects publicly. Proxies and thumbnails are read constantly by
# the editor, and signing every one adds a round trip to a request that carries
# no secret. Leave empty and everything is served through a signed URL instead.
R2_PUBLIC_BASE_URL=""

# Deepgram. Word-level timestamps, which are what silence removal and captions
# are both made of — one call per asset during ingest, nothing at edit time.
#
# console.deepgram.com → API Keys. The ingest path sends raw mono 16kHz PCM
# rather than the video, which is roughly two orders of magnitude smaller and
# transcribes no worse, because the model downsamples to that anyway.
#
# Optional. Unset, ingest still completes and the asset still goes `ready` with
# a warning on it — footage you cannot yet caption beats footage you cannot
# open. Music and b-roll have no transcript by definition.
DEEPGRAM_API_KEY=""

# Optional. Deepgram's speech model. `nova-3` is the current general model;
# pinning it here means a provider default changing under us is a deliberate
# edit rather than a silent change in every transcript.
#
# Leave it empty unless you mean it: the model is chosen from the language
# below, because nova-3 only speaks English and pinning it would undo that.
DEEPGRAM_MODEL=""

# What language the recordings are in, as a Deepgram code — `no` Norwegian,
# `sv` Swedish, `de` German, `es` Spanish. Empty means English.
#
# Set it. Deepgram does not refuse a language its model cannot speak: asked for
# English, it transcribed fifteen seconds of Norwegian as "Okay. Okay." at
# 0.975 confidence. That reads as a quiet recording rather than a failed
# transcript, and silence removal then cuts the talk down to those two words.
#
# Not `detect_language`, which was the obvious answer and is not reliable
# enough to be the default — on a Norwegian take opening with "Ok" it detects
# English and returns one word.
DEEPGRAM_LANGUAGE=""

# Comma-separated languages to fall back through when a transcript does not
# describe the audio — e.g. "en,no,sv". The primary above and English are
# always included, so this is only for a library that spans more than two.
#
# The check is density: speech runs 2-3 words per second of voice, and a
# wrong-language pass manages a fraction of that. Ingest already measures the
# waveform from the same audio, so the test is free and the retry only fires on
# evidence. Trial rather than Deepgram's own detect_language, which reported
# English on a Norwegian recording at 0.96 confidence.
DEEPGRAM_LANGUAGES=""
